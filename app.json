{
  "expo": {
    "name": "JapanEx",
    "slug": "japanex",
    "version": "1.0.0",
    "description": "Track how deeply you have experienced Japan's 47 prefectures.",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-japanex-v3.png",
    "scheme": "japanex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/japanex.icon",
      "supportsTablet": true,
      "bundleIdentifier": "dev.expo.kudo.japanex",
      "appleTeamId": "J35SUS5UFB",
      "associatedDomains": [
        "applinks:japanex.expo.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.expo.kudo.japanex",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "japanex.expo.app",
              "pathPrefix": "/view"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#203A47",
        "foregroundImage": "./assets/images/app-icon-japanex-v3-adaptive-foreground.png",
        "monochromeImage": "./assets/images/app-icon-japanex-v3-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-japanex-v3.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#203A47",
          "image": "./assets/images/app-icon-japanex-v3-adaptive-foreground.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1546cc10-b86a-458f-a750-7d7d263cd20d"
      }
    }
  }
}
