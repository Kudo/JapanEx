{
  "name": "japanex-expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.7",
    "expo": "^58.0.0-preview.7",
    "expo-build-properties": "~58.0.7",
    "expo-clipboard": "~58.0.1",
    "expo-constants": "~58.0.7",
    "expo-dev-client": "~58.0.7",
    "expo-device": "~58.0.2",
    "expo-file-system": "~58.0.2",
    "expo-font": "~58.0.2",
    "expo-image": "~58.0.6",
    "expo-image-manipulator": "~58.0.8",
    "expo-linking": "~58.0.7",
    "expo-localization": "~58.0.1",
    "expo-router": "~58.0.8",
    "expo-sharing": "~58.0.10",
    "expo-splash-screen": "~58.0.1",
    "expo-sqlite": "~58.0.6",
    "expo-status-bar": "~58.0.1",
    "expo-symbols": "~58.0.2",
    "expo-system-ui": "~58.0.2",
    "expo-web-browser": "~58.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/utils/*.test.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "verify": "node scripts/validate-data.mjs && node --experimental-strip-types --test src/utils/*.test.mjs && tsc --noEmit && expo lint",
    "export:web": "expo export --platform web"
  },
  "private": true,
  "patchedDependencies": {
    "@expo/ui@58.0.7": "patches/@expo%2Fui@58.0.7.patch"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-ui"
        ]
      },
      "ios": {
        "buildFromSource": [
          "ExpoUI"
        ]
      }
    }
  }
}
