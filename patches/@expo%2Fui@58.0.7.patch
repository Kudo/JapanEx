+private fun fixedOrBoundedConstraints(
+  width: Int?,
+  height: Int?,
+  maxWidth: Int,
+  maxHeight: Int
+): Constraints = Constraints(
+  minWidth = width ?: 0,
+  maxWidth = width ?: maxWidth,
+  minHeight = height ?: 0,
+  maxHeight = height ?: maxHeight
