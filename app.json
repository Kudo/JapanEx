{
  "expo": {
    "name": "JapanEx",
    "slug": "japanex",
    "version": "1.0.0",
    "description": "Track how deeply you have experienced Japan's 47 prefectures.",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-japanex-v3.png",
    "scheme": "japanex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/japanex.icon",
      "supportsTablet": true,
      "bundleIdentifier": "dev.expo.kudo.japanex",
      "appleTeamId": "J35SUS5UFB"
    },
    "android": {
      "package": "dev.expo.kudo.japanex",
      "adaptiveIcon": {
        "backgroundColor": "#203A47",
        "foregroundImage": "./assets/images/app-icon-japanex-v3-adaptive-foreground.png",
        "monochromeImage": "./assets/images/app-icon-japanex-v3-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-japanex-v3.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#203A47",
          "image": "./assets/images/app-icon-japanex-v3-adaptive-foreground.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow JapanEx to save your result image.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
